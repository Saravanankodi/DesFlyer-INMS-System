# ---------------------------------------------------------------------------
# INMS Firebase configuration TEMPLATE.
# Copy this file to `.env` and fill in the values for YOUR Firebase project.
# `.env` is git-ignored and must never be committed.
# Full beginner-friendly instructions: FIREBASE_SETUP.md
# ---------------------------------------------------------------------------

# 1. Firebase Project settings -> General -> Project ID
FIREBASE_PROJECT_ID=your-project-id

# 2. Storage bucket. Firebase Console -> Storage -> bucket name at the top.
#    Older projects:  <project-id>.appspot.com
#    Newer projects:  <project-id>.firebasestorage.app
#    Use exactly the name the console shows - they are NOT interchangeable.
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# 3. Web API key (Project settings -> General -> Your apps -> Web app -> apiKey).
#    Required to verify passwords through Firebase Authentication.
FIREBASE_WEB_API_KEY=your-web-api-key

# 4. Service account key. Firebase Console -> Project settings -> Service
#    accounts -> "Generate new private key", then save the JSON file inside
#    the project's secrets/ folder (git-ignored).
FIREBASE_CREDENTIALS_FILE=secrets/firebase-service-account.json
# Absolute paths also work:
# FIREBASE_CREDENTIALS_FILE=C:\path\to\serviceAccountKey.json
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\serviceAccountKey.json
# FIREBASE_CREDENTIALS={"type":"service_account","project_id":"..."}   # inline JSON

# 5. Flask session signing key. Generate one with:
#    python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-long-random-value

# ---------------------------------------------------------------------------
# Development / automated testing against the LOCAL Firebase Emulator Suite.
# Keep 0 for the real project. Never set to 1 in production.
# ---------------------------------------------------------------------------
FIREBASE_USE_EMULATORS=0
